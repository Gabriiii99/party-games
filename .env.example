# Copia questo file rinominandolo ".env" (nella stessa cartella) e riempi i valori.
# Il file .env e' in .gitignore: non finisce su GitHub e non va incollato in chat.

# --- Database (Neon) ---------------------------------------------------------
# Dove trovarle: neon.com -> il tuo progetto -> pulsante "Connect".
#   DATABASE_URL = connection string con "Connection pooling" ATTIVO  (usata dall'app)
#   DIRECT_URL   = connection string con "Connection pooling" SPENTO  (usata dalle migrazioni)
# Servono dalla Fase 1 in poi. Nella Fase 0 (scaffold) puoi lasciarle vuote.
DATABASE_URL=""
DIRECT_URL=""

# --- Sicurezza ---------------------------------------------------------------
# Chiave con cui vengono firmati i token di login.
# In locale va bene qualsiasi stringa lunga; in produzione usane una random di 32+ caratteri.
JWT_SECRET=""

# --- Server ------------------------------------------------------------------
# In locale il backend sta sulla 3000. Su Render la porta la inietta Render stesso.
PORT=3000
